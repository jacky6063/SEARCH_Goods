<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.example.searchgoods</string>
  <key>ProgramArguments</key>
  <array>
    <string>/opt/search_goods/.venv/bin/gunicorn</string>
    <string>-c</string>
    <string>/opt/search_goods/backend/gunicorn_conf.py</string>
    <string>app:app</string>
  </array>
  <key>WorkingDirectory</key>
  <string>/opt/search_goods</string>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>StandardOutPath</key>
  <string>/var/log/search_goods.out.log</string>
  <key>StandardErrorPath</key>
  <string>/var/log/search_goods.err.log</string>
</dict>
</plist>
