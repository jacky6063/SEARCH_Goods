DATA_PATH=../data/VIEW_GOODS_enhanced.csv
HOST=0.0.0.0
PORT=8000

# ========== OpenAI API 設定 ==========
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-4o-mini

# ========== LLM 功能開關 ==========
USE_LLM_EXPAND=True
USE_LLM_INTENT=True
USE_LLM_RERANK=False
USE_LLM_SHORTDESC=False
USE_LLM_PROMO=False

# ========== 聊天模式設定 ==========
USE_CHAT_MODE=True
CHAT_SYS_MAX_ITEMS=200
CHAT_MODEL=gpt-4o-mini

# ========== 🎙️ 語音模式設定 ==========
# 管理後台僅需設定 voice_mode_enabled，後端使用 OPENAI_API_KEY 呼叫 Whisper API

# ========== 🔧 住宅維修服務設定 ==========
# 啟用維修服務模組（預設關閉，不影響現有商品搜尋功能）
ENABLE_REPAIR_SERVICE=False

# 維修資料 CSV 路徑（選填，預設使用 data/集合式住宅報修資料.csv）
REPAIR_DATA_PATH=../data/集合式住宅報修資料.csv

# 維修服務是否使用 LLM（預設啟用，需要 OPENAI_API_KEY）
REPAIR_USE_LLM=True

# 維修服務使用的 OpenAI 模型（預設使用 OPENAI_MODEL 設定）
REPAIR_OPENAI_MODEL=gpt-4o-mini

