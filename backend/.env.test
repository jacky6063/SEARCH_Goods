DATA_PATH=../data/VIEW_GOODS_enhanced.csv
HOST=0.0.0.0
PORT=8000
OPENAI_API_KEY=your-openai-api-key

# === 測試情境：搜索功能啟用 LLM，聊天功能停用 LLM ===
SEARCH_USE_LLM_EXPAND=True
SEARCH_USE_LLM_INTENT=True  
SEARCH_USE_LLM_RERANK=False
SEARCH_USE_LLM_SHORTDESC=True
SEARCH_USE_LLM_PROMO=False
SEARCH_OPENAI_MODEL=gpt-4o-mini

# === 聊天功能完全停用 LLM ===
CHAT_USE_LLM_EXPAND=False
CHAT_USE_LLM_INTENT=False
CHAT_USE_LLM_RERANK=False
CHAT_USE_LLM_SHORTDESC=False
CHAT_USE_LLM_PROMO=False
CHAT_OPENAI_MODEL=gpt-4o-mini
USE_CHAT_MODE=True
CHAT_SYS_MAX_ITEMS=200

# === 向後相容性設定（保持舊參數以防其他地方使用）===
USE_LLM_EXPAND=True
USE_LLM_INTENT=True
USE_LLM_RERANK=False
USE_LLM_SHORTDESC=False
USE_LLM_PROMO=False
OPENAI_MODEL=gpt-4o-mini
CHAT_MODEL=gpt-4o-mini