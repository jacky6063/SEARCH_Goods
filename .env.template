# SEARCH_Goods 環境變數設定範本
# 複製此檔案為 .env.dev（開發環境）或 .env（生產環境）

# ============================================================
# 資料檔案路徑
# ============================================================
# 商品資料 CSV 檔案路徑（相對於 backend/ 目錄）
DATA_PATH=../data/VIEW_GOODS_enhanced.csv

# 商品分類 CSV 檔案路徑（相對於 backend/ 目錄）
CATEGORIES_PATH=../data/goods_categories.csv

# ============================================================
# 分頁設定（重要！影響查詢結果數量）
# ============================================================
# 一般查詢的預設分頁大小
# 本地開發：建議 30（方便測試完整結果）
# 生產環境：建議 6-12（優化載入速度）
DEFAULT_PAGE_SIZE=30

# 熱門分類點擊的分頁大小
# ⚠️ 此參數直接影響首頁熱門分類按鈕點擊後的顯示數量
# 本地開發：建議與生產環境一致，避免測試誤差
# 生產環境：建議 6（符合 UI 設計）
HOT_CATEGORY_PAGE_SIZE=6

# ============================================================
# OpenAI API 設定
# ============================================================
# OpenAI API Key（若不使用 LLM 功能可留空）
OPENAI_API_KEY=

# OpenAI 模型選擇
OPENAI_MODEL=gpt-4o-mini

# ============================================================
# LLM 功能開關
# ============================================================
# 查詢擴展：將使用者輸入擴展為更多搜尋關鍵字
USE_LLM_EXPAND=False

# 結果重排：使用 LLM 重新排序搜尋結果
USE_LLM_RERANK=False

# 短描述生成：為商品生成 20 字簡短描述
USE_LLM_SHORTDESC=False

# 意圖分析：解析使用者查詢意圖（必要關鍵字、排除關鍵字）
USE_LLM_INTENT=False

# 促銷內容生成：自動生成行銷文案
USE_LLM_PROMO=False

# ============================================================
# 搜尋功能開關（對應 SearchRequest 模型）
# ============================================================
# 搜尋時是否使用查詢擴展（需 USE_LLM_EXPAND=True）
SEARCH_USE_EXPAND=False

# 搜尋時是否使用結果重排（需 USE_LLM_RERANK=True）
SEARCH_USE_RERANK=False

# ============================================================
# 管理功能
# ============================================================
# 管理員 Token（用於 CSV 上傳、清除快取等管理端點）
# ⚠️ 生產環境必須設定強密碼！
ADMIN_TOKEN=your-secure-admin-token-here

# 開發環境是否允許無 Token 的管理操作（生產環境禁止開啟）
ALLOW_DEV_ADMIN=0

# ============================================================
# 伺服器設定
# ============================================================
# 伺服器監聽埠號
PORT=8000

# Python 模組搜尋路徑（通常不需要手動設定）
# PYTHONPATH=

# ============================================================
# 快取設定
# ============================================================
# 會話快取存活時間（秒）
SESSION_CACHE_TTL=600

# ============================================================
# 日誌設定
# ============================================================
# 日誌等級（DEBUG, INFO, WARNING, ERROR）
LOG_LEVEL=INFO

# ============================================================
# 環境識別（可選）
# ============================================================
# 環境名稱（用於日誌識別）
ENVIRONMENT=development
