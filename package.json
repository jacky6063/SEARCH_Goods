{
  "name": "search-goods",
  "version": "1.0.0",
  "description": "SEARCH_Goods - A lightweight product search system with natural language support",
  "scripts": {
    "deploy": "./scripts/auto_deploy.sh",
    "deploy:force": "./scripts/auto_deploy.sh --force",
    "deploy:watch": "./scripts/watch_deploy.sh",
    "setup": "./scripts/setup.sh",
    "test": "cd backend && python -m pytest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:headed": "playwright test --headed",
    "start:backend": "cd backend && uvicorn app:app --reload --host 0.0.0.0 --port 8000",
    "start:frontend": "cd frontend && python -m http.server 5173",
    "docker:dev": "docker compose -f docker-compose.dev.yml up --build",
    "docker:prod": "docker compose up --build",
    "prepare": "husky"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jacky6063/SEARCH_Goods.git"
  },
  "keywords": [
    "search",
    "goods",
    "nlp",
    "fastapi",
    "docker"
  ],
  "author": "jacky6063",
  "license": "MIT",
  "devDependencies": {
    "@playwright/test": "^1.57.0",
    "husky": "^9.1.7"
  },
  "engines": {
    "node": ">=14.0.0"
  },
  "scripts_extra": {},
  "playwright": {
    "baseURL": "http://localhost:8000"
  },
  "main": "index.js",
  "directories": {
    "doc": "docs"
  },
  "bugs": {
    "url": "https://github.com/jacky6063/SEARCH_Goods/issues"
  },
  "homepage": "https://github.com/jacky6063/SEARCH_Goods#readme",
  "dependencies": {
    "@supabase/supabase-js": "^2.81.1",
    "dotenv": "^17.2.3",
    "playwright": "^1.57.0"
  }
}
